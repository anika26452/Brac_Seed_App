<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="5dp"
    android:background="@color/white"
    tools:context=".Activity.DealerPayment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:weightSum="100">

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="35"
                android:text="Organization"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="15sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3"
                android:text=":"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="15sp" />

            <com.toptoche.searchablespinnerlibrary.SearchableSpinner
                android:id="@+id/org_spinner"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="62"
                android:enabled="false"
                android:textColor="?android:attr/textColorPrimary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:weightSum="100">

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="35"
                android:text="Territory"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="15sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3"
                android:text=":"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="15sp" />

            <com.toptoche.searchablespinnerlibrary.SearchableSpinner
                android:id="@+id/territory_spinner"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="62"
                android:enabled="false"
                android:textColor="@android:color/black" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:weightSum="100">

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="35"
                android:text="Collection Type"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="15sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3"
                android:text=":"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="15sp" />

            <com.toptoche.searchablespinnerlibrary.SearchableSpinner
                android:id="@+id/collectiontype_spinner"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="62"
                android:enabled="false"
                android:textColor="@android:color/black" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:weightSum="100">

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="35"
                android:text="Bank Account"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="15sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3"
                android:text=":"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="15sp" />

            <com.toptoche.searchablespinnerlibrary.SearchableSpinner
                android:id="@+id/bank_spinner"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="62"
                android:enabled="false"
                android:textColor="@android:color/black" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:weightSum="100">

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="35"
                android:text="Branch name"
                android:gravity="center|start"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="15sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3"
                android:gravity="center|start"
                android:text=":"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/branchnameedittext"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="62"
                android:inputType="text"
                android:backgroundTint="@android:color/black"
                android:textSize="15sp"
                android:textColor="@android:color/black"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:weightSum="100">

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="35"
                android:text="Total Bank Deposit"
                android:gravity="center|start"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="15sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3"
                android:gravity="center|start"
                android:text=":"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/depositamtedittext"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="62"
                android:inputType="numberDecimal"
                android:backgroundTint="@android:color/black"
                android:textSize="15sp"
                android:textColor="@android:color/black"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:weightSum="100">

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="37"
                android:gravity="center|start"
                android:text="Transaction Date"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_weight="3"
                android:gravity="center"
                android:text=":"
                android:textColor="@color/black"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/transactiondate_edittext"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="50"
                android:backgroundTint="@android:color/black"
                android:gravity="start"
                android:textSize="16sp"
                android:textColor="@android:color/black"
                android:textColorHint="#6a7170" />

            <ImageView
                android:onClick="onClickDatePicker"
                android:layout_gravity="center"
                android:layout_weight="8"
                android:id="@+id/calenderview"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/calendar1" >
            </ImageView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:weightSum="100">

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="37"
                android:gravity="center|start"
                android:text="Deposited Date"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_weight="3"
                android:gravity="center"
                android:text=":"
                android:textColor="@color/black"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/depositdate_edittext"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="50"
                android:backgroundTint="@android:color/black"
                android:gravity="start"
                android:textSize="16sp"
                android:textColor="@android:color/black"
                android:textColorHint="#6a7170" />

            <ImageView
                android:onClick="onClickdepositDatePicker"
                android:layout_gravity="center"
                android:layout_weight="8"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/calendar1" >
            </ImageView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:weightSum="100">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="35"
                android:text="Account Date"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="15sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:text=":"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/currentdate_textvw"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="62"
                android:textSize="15sp"
                android:layout_gravity="center"
                android:textColor="@android:color/black"
                android:textColorHint="#6a7170" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:weightSum="100">

            <TextView
                android:gravity="center|start"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="35"
                android:text="Payment Type"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="15sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3"
                android:text=":"
                android:gravity="center|start"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="15sp" />

            <com.toptoche.searchablespinnerlibrary.SearchableSpinner
                android:id="@+id/paymenttype_spinner"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="62"
                android:enabled="false"
                android:padding="5dp"
                android:textColor="@android:color/black" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/indirptypewlayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:visibility="gone"
            android:weightSum="100">

            <EditText
                android:id="@+id/indirectptypeedittext"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="80"
                android:backgroundTint="@android:color/black"
                android:textSize="15sp"
                android:textColor="@android:color/black"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:weightSum="100">

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="35"
                android:text="Remarks"
                android:gravity="center|start"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="15sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3"
                android:gravity="center|start"
                android:text=":"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/remarksedittext"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="62"
                android:backgroundTint="@android:color/black"
                android:textSize="15sp"
                android:textColor="@android:color/black"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/revertreject_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:weightSum="100">

            <TextView
                android:id="@+id/revertreject_textview"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="35"
                android:text="Reason"
                android:gravity="center|start"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="15sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3"
                android:gravity="center|start"
                android:text=":"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/reason_textview"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="62"
                android:text=""
                android:textSize="15sp"
                android:textColor="@android:color/black"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="30dp">

            <TextView
                android:layout_gravity="center"
                android:textColor="@color/darkgreen"
                android:textSize="18sp"
                android:textStyle="bold"
                android:text="Cost Center Selection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"></TextView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:weightSum="100">

            <TextView
                android:layout_gravity="center"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="35"
                android:text="Business Partner"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="15sp" />

            <TextView
                android:layout_gravity="center"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3"
                android:text=":"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="15sp" />

            <com.toptoche.searchablespinnerlibrary.SearchableSpinner
                android:id="@+id/bp_spinner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="62"
                android:enabled="false"
                android:padding="5dp"
                android:textColor="@android:color/black" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:weightSum="100">

            <TextView
                android:layout_gravity="center"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="35"
                android:text="Cost Center"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="15sp" />

            <TextView
                android:layout_gravity="center"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3"
                android:text=":"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="15sp" />

            <com.toptoche.searchablespinnerlibrary.SearchableSpinner
                android:id="@+id/costcenter_spinner"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="62"
                android:enabled="false"
                android:padding="5dp"
                android:textColor="@android:color/black" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:weightSum="100">

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="35"
                android:text="Paid Amt"
                android:gravity="center|start"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="15sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3"
                android:gravity="center|start"
                android:text=":"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/paymentamtedittext"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="62"
                android:inputType="number"
                android:backgroundTint="@android:color/black"
                android:textSize="15sp"
                android:textColor="@android:color/black"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:weightSum="100"
            android:gravity="center"
            android:layout_marginTop="30dp">

            <Button
                android:id="@+id/addcostcentre_btn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_weight="50"
                app:backgroundTint="@color/bracgreend"
                android:text="Add Cost Center"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textColor="@color/white" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/proviewlayout"
            android:orientation="vertical"
            android:visibility="visible"
            android:layout_marginTop="30dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:background="@color/bracgreen"
                android:weightSum="100">

                <TextView
                    android:text="Cost Center"
                    android:textColor="@color/white"
                    android:layout_height="wrap_content"
                    android:layout_width="0dp"
                    android:layout_weight="35"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:layout_gravity="center"
                    android:gravity="center">
                </TextView>

                <TextView
                    android:text="Business Partner"
                    android:textColor="@color/white"
                    android:layout_height="wrap_content"
                    android:layout_width="0dp"
                    android:layout_weight="35"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:layout_gravity="center"
                    android:gravity="center">
                </TextView>

                <TextView
                    android:text="Paid Amt"
                    android:textColor="@color/white"
                    android:layout_height="wrap_content"
                    android:layout_width="0dp"
                    android:layout_weight="20"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:layout_gravity="center"
                    android:gravity="center">
                </TextView>

                <TextView
                    android:text="Cancel"
                    android:textColor="@color/white"
                    android:layout_height="wrap_content"
                    android:layout_width="0dp"
                    android:layout_weight="10"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:layout_gravity="center"
                    android:gravity="center">
                </TextView>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="10dp"
                android:layout_weight="67"
                android:orientation="vertical">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/showrecyclervw"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                </androidx.recyclerview.widget.RecyclerView>

            </LinearLayout>

            <LinearLayout
                android:visibility="gone"
                android:layout_width="match_parent"
                android:weightSum="100"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="20dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="start"
                    android:textColor="@color/black"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:text="Total : "
                    android:layout_weight="70">
                </TextView>

                <TextView
                    android:id="@+id/tdpaidamt"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:gravity="end"
                    android:textColor="@color/black"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:text=""
                    android:layout_weight="20">
                </TextView>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="start"
                    android:textColor="@color/black"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_weight="10">
                </TextView>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:gravity="center"
                android:layout_marginBottom="30dp"
                android:orientation="horizontal">

                <Button
                    android:textColor="@color/white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Send to server"
                    android:padding="10dp"
                    android:textAllCaps="false"
                    android:backgroundTint="@color/darkgreen"
                    android:id="@+id/submit_button"
                    android:layout_gravity="center"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:onClick="gotoProductActivity"
                    />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:weightSum="100"
            android:gravity="center"
            android:layout_marginTop="100dp">

            <Button
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_weight="50"
                app:backgroundTint="@color/darkgreen"
                android:onClick="gotoProductActivity"
                android:text="Submit"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/white" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>