<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/white"
    tools:context="com.sysnova.brac_seed_app.Activity.ViewDealerPayment">

    <LinearLayout
        android:layout_width="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingVertical="10dp"
        android:paddingHorizontal="5dp"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:padding="10dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Date : "
                android:textColor="@color/bracgreend"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginRight="10sp"
                android:padding="3dp">
            </TextView>

            <Button
                android:id="@+id/date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:backgroundTint="@color/bracgreend"
                android:gravity="center"
                android:text="Date" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="35dp"
            android:orientation="horizontal"
            android:weightSum="100">
            <TextView
                android:text="SL#"
                android:textColor="@color/bracgreend"
                android:layout_height="match_parent"
                android:layout_width="0dp"
                android:layout_weight="5"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textSize="11sp"
                android:gravity="center">
            </TextView>

            <TextView
                android:text="Dealer"
                android:textColor="@color/bracgreend"
                android:layout_height="match_parent"
                android:layout_width="0dp"
                android:layout_weight="25"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textSize="11sp"
                android:gravity="center">
            </TextView>

            <TextView
                android:text="Bank Acc."
                android:textColor="@color/bracgreend"
                android:layout_height="match_parent"
                android:layout_width="0dp"
                android:layout_weight="25"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textSize="11sp"
                android:gravity="center">
            </TextView>

            <TextView
                android:text="PayAmt"
                android:textColor="@color/bracgreend"
                android:layout_height="match_parent"
                android:layout_width="0dp"
                android:layout_weight="15"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textSize="11sp"
                android:gravity="center">
            </TextView>

            <TextView
                android:text="Cost Center"
                android:textColor="@color/bracgreend"
                android:layout_height="match_parent"
                android:layout_width="0dp"
                android:layout_weight="15"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textSize="11sp"
                android:gravity="center">
            </TextView>

            <TextView
                android:text="Status"
                android:textColor="@color/bracgreend"
                android:layout_height="match_parent"
                android:layout_width="0dp"
                android:layout_weight="15"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textSize="10sp"
                android:gravity="center">
            </TextView>

<!--            <TextView-->
<!--                android:textColor="@color/bracgreend"-->
<!--                android:text="View"-->
<!--                android:layout_height="match_parent"-->
<!--                android:layout_width="0dp"-->
<!--                android:layout_weight="15"-->
<!--                android:padding="10sp"-->
<!--                android:textAllCaps="false"-->
<!--                android:textStyle="bold"-->
<!--                android:textSize="11sp"-->
<!--                android:gravity="center">-->
<!--            </TextView>-->

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="15dp"
            android:layout_weight="10"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/no_list_id"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textStyle="bold">

            </TextView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="5dp"
            android:layout_weight="67"
            android:orientation="vertical">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/showorderinlist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

            </androidx.recyclerview.widget.RecyclerView>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:id="@+id/linear_layout1"
            android:layout_marginBottom="5dp"
            android:layout_marginTop="5dp">

            <Button
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight=".4"
                android:layout_marginRight="10dp"
                android:id="@+id/cancel_button"
                android:textColor="@color/brac_ash"
                android:onClick="callCancelNew"
                android:backgroundTint="@color/colorPrimary"
                android:text="Back" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>