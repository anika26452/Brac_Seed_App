<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:weightSum="100"
    android:background="@color/white"
    >

    <TextView
        android:id="@+id/sl_id"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="5"
        android:text="SL#"
        android:textColor="@android:color/black"
        android:gravity="center"
        android:visibility="gone" >
    </TextView>

    <TextView
        android:id="@+id/product_name_id"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="20"
        android:gravity="left"
        android:text="Product"
        android:textColor="@android:color/black"
        android:textSize="9dp"></TextView>

    <TextView
        android:id="@+id/uom_id"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="8"
        android:text="Uom"
        android:textSize="9dp"
        android:textColor="@android:color/black"
        android:gravity="center">
    </TextView>
    <TextView
        android:id="@+id/no_ofbag"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="10"
        android:text="noofbag"
        android:textSize="9dp"
        android:textColor="@android:color/black"
        android:gravity="center"
        >
    </TextView>
    <TextView
        android:id="@+id/qty_bag_id"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="10"
        android:text="Quantity"
        android:textSize="9dp"
        android:textColor="@android:color/black"
        android:gravity="center"
        >
    </TextView>

    <TextView
        android:id="@+id/rate_id"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="13"
        android:text="Rate"
        android:textColor="@android:color/black"
        android:textSize="9dp"
        android:gravity="center"
        >
    </TextView>
    <TextView
        android:id="@+id/dis_price"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="12"
        android:text="Discount"
        android:textSize="9dp"
        android:textColor="@android:color/black"
        android:gravity="center"
        >
    </TextView>
    <TextView
        android:id="@+id/bonus_price"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="12"
        android:text="bonus"
        android:textSize="9dp"
        android:textColor="@android:color/black"
        android:gravity="center"
        >
    </TextView>
    <TextView
        android:id="@+id/total_taka_id"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="15"
        android:text="Total"
        android:textSize="9dp"
        android:textColor="@android:color/black"
        android:gravity="center"
        >
    </TextView>
<!--    <TextView-->
<!--        android:id="@+id/edit_btn_id"-->
<!--        android:layout_width="0dp"-->
<!--        android:layout_height="wrap_content"-->
<!--        android:layout_weight="7"-->
<!--        android:text="Edit"-->
<!--        android:textStyle="bold"-->
<!--        android:textColor="@android:color/holo_red_dark"-->
<!--        android:gravity="center"-->
<!--        android:background="@color/colorGreen"-->
