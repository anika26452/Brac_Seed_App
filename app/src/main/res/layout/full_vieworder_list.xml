<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="match_parent"

        android:orientation="horizontal"
        android:layout_height="45dp"
        android:weightSum="100">

        <TextView
            android:id="@+id/serial_id"
            android:layout_width="10dp"
            android:layout_height="wrap_content"
            android:layout_weight="8"
            android:gravity="center"
            android:text="SL#"
            android:textStyle="bold"></TextView>

        <!--<TextView
            android:id="@+id/order_doc"
            android:layout_width="25dp"
            android:layout_height="wrap_content"
            android:layout_weight="30"
            android:gravity="center"
            android:text="Order Document No"
            android:textStyle="bold"></TextView>-->

        <TextView
            android:id="@+id/sended_date"
            android:layout_width="20dp"
            android:layout_height="wrap_content"
            android:layout_weight="22"
            android:gravity="center"
            android:text="dealer"
            android:textStyle="bold"></TextView>

        <TextView
            android:id="@+id/erp_doc"
            android:layout_width="25dp"
            android:layout_height="wrap_content"
            android:layout_weight="45"
            android:gravity="center"
            android:text="erp Document No"
            android:textStyle="bold"></TextView>

        <TextView
            android:id="@+id/go_approval"
            android:layout_width="20dp"
            android:layout_height="wrap_content"
            android:layout_weight="25"
            android:background="@android:color/background_light"
            android:gravity="center"
            android:text="Go and Approve"
            android:textColor="@android:color/holo_red_dark"
            android:textStyle="bold"></TextView>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_margin="10dp"
        android:background="@android:color/white" />

</LinearLayout>